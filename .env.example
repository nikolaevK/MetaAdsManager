# ── Database ────────────────────────────────────────────────────────────────
# Local development uses a SQLite file. In production point this at Turso:
#   DATABASE_URL=libsql://<db>-<org>.turso.io
#   DATABASE_AUTH_TOKEN=<turso db tokens create ...>
DATABASE_URL=file:./data/app.db
DATABASE_AUTH_TOKEN=

# ── Meta Marketing API ─────────────────────────────────────────────────────
# System-user / development access token with ads_management, ads_read,
# business_management, pages_read_engagement, pages_show_list scopes.
# Server-only: never exposed to the browser and never written to the DB.
META_ACCESS_TOKEN=
# App secret enables appsecret_proof on every call and webhook signature checks.
META_APP_SECRET=
META_APP_ID=
META_API_VERSION=v26.0
# Any random string; paste the same value into the Meta app's webhook settings.
META_WEBHOOK_VERIFY_TOKEN=
# Local testing only: send Graph API calls to a mock server instead of graph.facebook.com.
# META_GRAPH_BASE_URL=http://localhost:4555

# ── App ────────────────────────────────────────────────────────────────────
# Public origin of the app (used for CSRF origin checks on route handlers).
APP_URL=http://localhost:3000
# Bearer secret for /api/cron (scheduler + job worker tick). openssl rand -hex 32
CRON_SECRET=
# Run background jobs inside the Next server (local dev / single box). In production prefer `npm run worker`.
INLINE_WORKER=false
# Creative files live in a private Vercel Blob store. On Vercel the connected store's variables are set for you;
# locally, use its read-write token (`vercel env pull`, or copy it from the store's page).
BLOB_READ_WRITE_TOKEN=

# First admin user, created by `npm run db:seed` if no users exist.
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=

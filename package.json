{
  "name": "meta-ads-manager",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx --env-file-if-exists=.env --env-file-if-exists=.env.local --conditions=react-server scripts/migrate.mts",
    "db:seed": "tsx --env-file-if-exists=.env --env-file-if-exists=.env.local --conditions=react-server scripts/seed.mts",
    "user:create": "tsx --env-file-if-exists=.env --env-file-if-exists=.env.local --conditions=react-server scripts/create-user.mts",
    "worker": "tsx --env-file-if-exists=.env --env-file-if-exists=.env.local --conditions=react-server scripts/worker.mts",
    "accounts:sync": "tsx --env-file-if-exists=.env --env-file-if-exists=.env.local --conditions=react-server scripts/sync-accounts.mts"
  },
  "dependencies": {
    "@libsql/client": "^0.18.0",
    "drizzle-orm": "^0.45.4",
    "lucide-react": "^1.63.0",
    "next": "16.4.3",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "^0.0.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^24.19.2",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "drizzle-kit": "^0.31.11",
    "eslint": "^9",
    "eslint-config-next": "16.4.3",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^5.0.5"
  },
  "engines": {
    "node": ">=22.12"
  }
}
